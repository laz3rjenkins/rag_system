LLM_PATH= # путь к локальной модели .gguf
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base # модель для эмбеддингов

# --- ChromaDB ---
CHROMA_COLLECTION=rag_prompt_context
DATA_DIR= # путь к каталогу с PDF (по умолчанию ./data)

# --- Эмбеддинги (для e5 нужны префиксы; кавычки сохраняют пробел после двоеточия) ---
EMBED_QUERY_PREFIX="query: "
EMBED_PASSAGE_PREFIX="passage: "

# --- Поиск ---
RETRIEVAL_K=4

# --- LLM (llama.cpp) ---
LLM_N_CTX=15678
LLM_N_THREADS=8
LLM_N_GPU_LAYERS=-1   # -1 = все слои на GPU, 0 = только CPU
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.0
LLM_REPEAT_PENALTY=1.0

# --- База данных ---
# В Docker DB_HOST должен быть именем сервиса (mariadb), а не localhost
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=mol_consultant_db
